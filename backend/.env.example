DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# A PostgreSQL role that may create databases. scripts/db-init.sh creates the
# database itself if it is missing.
DATABASE_URL=postgres://orgsurvey:orgsurvey@localhost:5432/orgsurvey_dev

# A workspace lives at <subdomain>.<TENANT_BASE_DOMAIN>, e.g. abc.localhost
TENANT_BASE_DOMAIN=localhost
TENANT_PLATFORM_SUBDOMAINS=admin,api,www,app

# What "today" means for due dates and overdue counts (an IANA zone name).
TIME_ZONE=UTC
